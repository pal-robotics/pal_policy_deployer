<launch>
  <!-- Start the preprocessor -->
  <node
    pkg="pal_policy_preprocessor"
    exec="pal_policy_preprocessor_ik_node"
    name="pal_policy_preprocessor_ik"
    output="screen"
  />

  <!-- Start the inferer -->
  <node
    pkg="pal_policy_inferer"
    exec="pal_policy_inferer_ik_node"
    name="pal_policy_inferer_ik"
    output="screen"
  />

  <!-- Start the interactive node -->
  <node
    pkg="pal_policy_preprocessor"
    exec="pal_policy_preprocessor_interactive_node"
    name="pal_policy_preprocessor_interactive"
    output="screen"
  />
</launch>
