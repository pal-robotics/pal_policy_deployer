<launch>
  <!-- Preprocessor -->
  <node
    pkg="pal_policy_preprocessor"
    exec="pal_policy_preprocessor_ik_node"
    name="pal_policy_preprocessor_ik"
    output="screen">
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- Inferer (does the TF transform) -->
  <node
    pkg="pal_policy_inferer"
    exec="pal_policy_inferer_ik_node"
    name="pal_policy_inferer_ik"
    output="screen">
    <param name="use_sim_time" value="true"/>
    <!-- Explicitly set frames -->
    <param name="source_frame" value="base_footprint"/>
    <param name="target_frame" value="arm_right_root_link"/>
  </node>

  <node
    pkg="pal_policy_inferer"
    exec="hermite_interpolator_node"
    name="hermite_interpolator"
    output="screen">
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- Interactive target publisher -->
  <node
    pkg="pal_policy_preprocessor"
    exec="pal_policy_preprocessor_interactive_node"
    name="pal_policy_preprocessor_interactive"
    output="screen">
    <param name="use_sim_time" value="true"/>
  </node>
</launch>
