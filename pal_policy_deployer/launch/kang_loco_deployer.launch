<launch>
  <!-- Start the preprocessor -->
  <node
    pkg="pal_policy_preprocessor"
    type="pal_policy_preprocessor_loco_node"
    name="pal_policy_preprocessor_loco"
    output="screen"
  />

  <node
    pkg="pal_policy_inferer"
    type="pal_policy_inferer_loco_node"
    name="pal_policy_inferer_loco"
    output="screen"
  />

  
  <!-- Bring up the subscriber controller -->
  <include file="$(find subscriber_controller)/launch/kangaroo_subscriber_controller.launch" />
</launch>
