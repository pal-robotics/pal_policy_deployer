<launch>
  <!-- launch argument: use true for simulation, false for real robot -->
  <arg name="use_sim_time" default="false"/>

  <!-- one shared model path for all nodes -->
  <!-- when launching use onnx_model_path:=/abs/path/to/model.onnx or change in default-->
  <arg name="onnx_model_path" default="$(find-pkg-share pal_policy_deployer)/models/tiagopro/exported/reaching_tiagopro.onnx"/>

  <!-- Preprocessor -->
  <node
    pkg="pal_policy_preprocessor"
    exec="pal_policy_preprocessor_node"
    name="pal_policy_preprocessor"
    output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="onnx_model_path" value="$(var onnx_model_path)"/>
  </node>

  <!-- Inferer -->
  <node
    pkg="pal_policy_inferer"
    exec="pal_policy_inferer_node"
    name="pal_policy_inferer"
    output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="onnx_model_path" value="$(var onnx_model_path)"/>
  </node>

  <!-- Postprocessor -->
  <node
    pkg="pal_policy_postprocessor"
    exec="pal_policy_postprocessor_node"
    name="pal_policy_postprocessor"
    output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
