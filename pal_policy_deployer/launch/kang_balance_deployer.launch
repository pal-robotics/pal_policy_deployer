<launch>
  <!-- Start the preprocessor -->
  <node
    pkg="pal_policy_preprocessor"
    type="pal_policy_preprocessor_balance_node"
    name="pal_policy_preprocessor_balance"
    output="screen"
  />

  <!-- <node
    pkg="pal_policy_inferer"
    type="pal_policy_inferer_balance_node"
    name="pal_policy_inferer_balance"
    output="screen"
  />

  <node
    pkg="pal_policy_postprocessor"
    type="pal_policy_postprocessor_node"
    name="pal_policy_postprocessor"
    output="screen"
  /> -->

  <node
    pkg="pal_policy_postprocessor"
    type="pal_policy_postprocessor_balance_node"
    name="pal_policy_postprocessor_balance"
    output="screen"
  /> 
  
  <!-- Bring up the subscriber controller -->
  <include file="$(find subscriber_controller)/launch/kangaroo_subscriber_controller.launch" />
</launch>
