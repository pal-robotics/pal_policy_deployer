<?xml version="1.0"?>
<package format="3">
  <name>pal_policy_deployer</name>
  <version>0.0.0</version>
  <description>The pal_policy_deployer package</description>

  <maintainer email="louislelay@pal-robotics.com">Louis Le Lay</maintainer>

  <license>Apache 2.0</license>

  <author email="louislelay@pal-robotics.com">Louis Le Lay</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>ament_cmake_auto</build_depend>

  <!-- Message generation -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <depend>std_msgs</depend>

  <!-- Aggregate the other packages at runtime -->
  <exec_depend>pal_policy_inferer</exec_depend>
  <exec_depend>pal_policy_preprocessor</exec_depend>
  <exec_depend>pal_policy_postprocessor</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
